<?xml version="1.0" encoding="utf-8" ?>
<component name="WifiTask" extends="Task">
    <interface>
        <field id="generation" type="integer" value="0" />
        <field id="busyPaths" type="string" value="" />
        <!-- ssid and password stay on this node for the screen. They are not printed. -->
        <field id="result" type="assocarray" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/secrets.brs" />
    <script type="text/brightscript" uri="pkg:/components/GuestConfig.brs" />
    <script type="text/brightscript" uri="pkg:/components/GuestRules.brs" />
    <script type="text/brightscript" uri="pkg:/components/GuideModel.brs" />
    <script type="text/brightscript" uri="pkg:/components/Season.brs" />
    <script type="text/brightscript" uri="pkg:/components/PngRgb.brs" />
    <script type="text/brightscript" uri="pkg:/components/WifiTask.brs" />
</component>
