<?xml version="1.0" encoding="utf-8" ?>
<component name="ActivityCard" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onItemContent" />
        <field id="focusPercent" type="float" />
        <field id="itemHasFocus" type="boolean" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/ActivityCard.brs" />

    <children>
        <Rectangle id="ring" width="364" height="488" color="0xF2A93BFF" visible="false" />
        <Rectangle id="fill" translation="[5, 5]" width="354" height="478" color="0x1A2438F2" />
        <Rectangle id="swatch" translation="[5, 5]" width="354" height="96" color="0x5C4033FF" />
        <Poster
            id="photo"
            translation="[5, 5]"
            width="354"
            height="96"
            loadWidth="354"
            loadHeight="96"
            loadDisplayMode="scaleToZoom"
            failedBitmapUri="pkg:/images/tv-placeholder.jpg"
            loadingBitmapUri="pkg:/images/tv-placeholder.jpg" />
        <Rectangle id="chip" translation="[16, 104]" width="332" height="99" color="0xF2A93BFF" />
        <Label
            id="chipText"
            translation="[16, 104]"
            width="332"
            height="99"
            horizAlign="center"
            vertAlign="center"
            wrap="true"
            maxLines="3"
            color="0x1C1408FF"
            font="font:SmallestBoldSystemFont" />
        <Label
            id="name"
            translation="[16, 208]"
            width="332"
            height="200"
            wrap="true"
            maxLines="5"
            vertAlign="top"
            color="0xFFFFFFFF"
            font="font:SmallBoldSystemFont" />
        <Label
            id="distance"
            translation="[16, 412]"
            width="332"
            height="66"
            wrap="true"
            maxLines="2"
            vertAlign="top"
            color="0xD5DBE8FF"
            font="font:SmallestSystemFont" />
    </children>
</component>
