<?xml version="1.0" encoding="utf-8" ?>
<component name="ActivityCard" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onItemContent" />
        <field id="focusPercent" type="float" />
        <field id="itemHasFocus" type="boolean" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/ActivityCard.brs" />

    <children>
        <Rectangle id="ring" width="364" height="252" color="0xF2A93BFF" visible="false" cornerRadius="18" />
        <Rectangle id="fill" translation="[5, 5]" width="354" height="242" color="0x1A2438F2" cornerRadius="16" />
        <Rectangle id="swatch" translation="[5, 5]" width="354" height="150" color="0x5C4033FF" />
        <Poster
            id="photo"
            translation="[5, 5]"
            width="354"
            height="150"
            loadWidth="354"
            loadHeight="150"
            loadDisplayMode="scaleToZoom"
            failedBitmapUri="pkg:/images/tv-placeholder.jpg"
            loadingBitmapUri="pkg:/images/tv-placeholder.jpg" />
        <Rectangle id="chip" translation="[16, 16]" width="132" height="32" color="0xF2A93BFF" cornerRadius="10" />
        <Label
            id="chipText"
            translation="[16, 16]"
            width="132"
            height="32"
            horizAlign="center"
            vertAlign="center"
            wrap="false"
            color="0x1C1408FF"
            font="font:SmallestBoldSystemFont" />
        <Label
            id="name"
            translation="[16, 162]"
            width="332"
            height="52"
            wrap="true"
            maxLines="2"
            vertAlign="top"
            color="0xFFFFFFFF"
            font="font:SmallBoldSystemFont" />
        <Label
            id="distance"
            translation="[16, 214]"
            width="332"
            height="28"
            color="0xD5DBE8FF"
            font="font:SmallSystemFont" />
    </children>
</component>
